"""
Polyfill implementation of module source operations needed by SDK development.
"""
type PolyfillModuleSource {
  let ws: Workspace!
  let cwd: String!
  let path: String!

  """
  Read and edit this module source's dagger.json.
  """
  config: PolyfillModuleConfig! {
    let configContents = PolyfillWorkspaceSnapshot.existingFile(
      wsID,
      configPath,
      configPath,
    ).file(configPath).contents
    PolyfillModuleConfig(
      ws: ws,
      cwd: cwd,
      path: path,
      originalContents: configContents,
      contents: configContents,
    )
  }

  """
  Return true when this module source has a dagger.json.
  """
  configExists: Boolean! {
    ws.directory("/", include: [configPath]).exists(configPath)
  }

  """
  Return this module source as a core ModuleSource.
  """
  core: ModuleSource! {
    ws.moduleSource(workspaceRef)
  }

  """
  Return a workspace-rooted directory view containing this module source.

  No longer filtered to the module's include set: a dir-kind module source
  loads the full workspace overlay rootfs as its context.
  """
  workspaceView: Directory! {
    core.contextDirectory
  }

  """
  Return the module source root path inside the workspace view.
  """
  sourceRootPath: String! {
    path
  }

  """
  Load this module source as a core Module.
  """
  module: Module! {
    core.asModule
  }

  """
  Return this module source's introspection schema file.
  """
  introspectionSchemaJSON: File! {
    module.introspectionSchemaJSON
  }

  """
  Generate files for this module source, and return the staged changes.

  Paths are relative to the caller cwd, matching how a returned changeset is
  applied.

  The engine diffs the generated context against the same base it generated
  from, so the changeset only ever carries this module's own generated files,
  never staged dependency codegen. Sibling modules' changesets therefore stay
  disjoint and merge cleanly without any module-path scoping here.
  """
  generate: Changeset! {
    let generated = core.generatedContextChangeset

    # The engine roots the generated context at the workspace, but a returned
    # changeset is applied relative to the caller cwd, so the two have to be
    # reconciled or every path ends up nested under the cwd a second time.
    # Selecting a subdirectory is metadata only, so this costs nothing.
    if (cwd == ".") {
      generated
    } else {
      # A cwd-relative changeset cannot express paths outside the cwd — e.g. a
      # module discovered above it — and re-rooting would silently drop them,
      # leaving the module never regenerated. Fail loudly until there is a
      # policy for such modules.
      let outside = (generated.addedPaths + generated.modifiedPaths + generated.removedPaths)
        .filter { p => p != cwd and p.hasPrefix(cwd + "/") == false }
      if (outside.length > 0) {
        raise "generated changes fall outside the current directory " + cwd + ": " + outside.join(", ")
      }

      generated.after.directory(cwd).changes(generated.before.directory(cwd))
    }
  }

  """
  Return this module source's dagger.json path from the workspace root.
  """
  let configPath: String! {
    if (path == ".") { "dagger.json" } else { path + "/dagger.json" }
  }

  let wsID: String! {
    JSON.encode(ws.id)
  }

  """
  Return this module source's path as a workspace-root-absolute ref, the form
  Workspace.moduleSource resolves from the workspace root rather than the cwd.
  """
  let workspaceRef: String! {
    if (path == ".") { "/" } else { "/" + path }
  }
}
